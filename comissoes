<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<title>Comissões - JD</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<style>
body{
  margin:0;
  font-family:'Segoe UI', Arial, sans-serif;
  background:url("fundo.jpg") no-repeat center center fixed;
  background-size:cover;
  color:#fff;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle at 30% 12%, rgba(33,150,243,0.18), transparent 45%),
    radial-gradient(circle at 80% 35%, rgba(76,175,80,0.10), transparent 45%),
    rgba(0,0,0,0.22);
  z-index:-1;
}

.container{
  max-width:1280px;
  margin:auto;
  padding:34px 26px;
}

.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  margin-bottom:18px;
}

.title{
  font-size:44px;
  font-weight:900;
  letter-spacing:.3px;
  margin:0;
}

.top-actions{
  display:flex;
  gap:12px;
  align-items:center;
}

.btn-pill{
  display:flex;
  align-items:center;
  gap:10px;
  padding:12px 18px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,0.18);
  background:rgba(0,0,0,0.25);
  backdrop-filter:blur(12px);
  cursor:pointer;
  color:#fff;
  font-weight:800;
  transition:.25s ease;
}

.btn-pill:hover{
  transform:translateY(-1px);
  background:rgba(255,255,255,0.12);
}

.filtros{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:12px;
  margin:16px 0 20px;
}

.control{
  width:100%;
  padding:12px 14px;
  border-radius:14px;
  border:1px solid rgba(255,255,255,0.16);
  background:rgba(0,0,0,0.22);
  color:#fff;
  outline:none;
  font-weight:800;
  backdrop-filter:blur(10px);
}

.control option{
  color:#000;
}

.grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:18px;
}

.card{
  background: rgba(0,0,0,0.18);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius:18px;
  padding:18px;
  backdrop-filter:blur(14px);
  box-shadow:0 18px 46px rgba(0,0,0,0.45);
}

.card h2{
  margin:0 0 14px;
  font-size:24px;
  font-weight:900;
}

.card p.sub{
  margin:0 0 16px;
  opacity:.86;
  font-weight:700;
}

.kpis{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:14px;
  margin-bottom:18px;
}

.kpi{
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.10);
  border-radius:16px;
  padding:14px;
}

.kpi-label{
  font-size:13px;
  font-weight:900;
  opacity:.9;
  margin-bottom:8px;
}

.kpi-value{
  font-size:26px;
  font-weight:900;
  color:#79ff9a;
}

.table-wrap{
  overflow:auto;
  border-radius:14px;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:760px;
}

thead th{
  text-align:left;
  font-size:13px;
  padding:14px 12px;
  background:rgba(255,255,255,0.10);
  border-bottom:1px solid rgba(255,255,255,0.10);
  white-space:nowrap;
}

tbody td{
  padding:14px 12px;
  border-bottom:1px solid rgba(255,255,255,0.08);
  font-size:14px;
  white-space:nowrap;
}

tbody tr:hover{
  background:rgba(255,255,255,0.06);
}

.input-mini{
  width:110px;
  padding:10px 12px;
  border-radius:10px;
  border:1px solid rgba(255,255,255,0.16);
  background:rgba(0,0,0,0.22);
  color:#fff;
  outline:none;
  font-weight:800;
}

.badge{
  display:inline-block;
  padding:6px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:900;
  background:rgba(33,150,243,0.24);
}

.form-grid{
  display:grid;
  grid-template-columns: 1.2fr .8fr .8fr auto;
  gap:12px;
  margin-bottom:18px;
}

.btn-add{
  border:none;
  border-radius:14px;
  background:linear-gradient(135deg,#0d63c9,#0b4da6);
  color:#fff;
  font-weight:900;
  cursor:pointer;
  padding:12px 16px;
  box-shadow:0 10px 24px rgba(0,0,0,0.35);
}

.btn-add:hover{
  transform:translateY(-1px);
}

.btn-remove{
  border:none;
  border-radius:10px;
  background:#e53935;
  color:#fff;
  font-weight:900;
  cursor:pointer;
  padding:8px 12px;
}

.total-box{
  margin-top:14px;
  padding:14px 16px;
  border-radius:14px;
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.10);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  font-weight:900;
}

.total-valor{
  color:#79ff9a;
  font-size:24px;
}

@media (max-width: 1100px){
  .filtros{ grid-template-columns: repeat(2, 1fr); }
  .grid{ grid-template-columns: 1fr; }
  .kpis{ grid-template-columns: 1fr; }
}

@media (max-width: 700px){
  .title{ font-size:32px; }
  .filtros{ grid-template-columns: 1fr; }
  .form-grid{ grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="container">

  <div class="topbar">
    <h1 class="title">Comissões</h1>
    <div class="top-actions">
      <button class="btn-pill" onclick="location.href='financeiro.html'">Financeiro</button>
      <button class="btn-pill" onclick="location.href='jader.html'">Voltar</button>
    </div>
  </div>

  <div class="filtros">
    <select id="filtroPeriodo" class="control">
      <option value="mes">Este mês</option>
      <option value="semana">Esta semana</option>
      <option value="dia">Hoje</option>
      <option value="personalizado">Período personalizado</option>
    </select>

    <input id="dataInicio" class="control" type="date">
    <input id="dataFim" class="control" type="date">

    <input id="filtroVendedor" class="control" type="text" placeholder="Filtrar vendedor">
  </div>

  <div class="grid">

    <!-- VENDEDORES -->
    <div class="card">
      <h2>Comissão de Vendedores</h2>
      <p class="sub">O Jader define quanto cada vendedor recebe por pedido vendido.</p>

      <div class="kpis">
        <div class="kpi">
          <div class="kpi-label">Vendas no período</div>
          <div class="kpi-value" id="kpiVendasPeriodo">0</div>
        </div>

        <div class="kpi">
          <div class="kpi-label">Comissão total</div>
          <div class="kpi-value" id="kpiComissaoVendedores">R$ 0,00</div>
        </div>

        <div class="kpi">
          <div class="kpi-label">Vendedores ativos</div>
          <div class="kpi-value" id="kpiVendedoresAtivos">0</div>
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Vendedor</th>
              <th>Pedidos vendidos</th>
              <th>Valor por venda</th>
              <th>Comissão total</th>
            </tr>
          </thead>
          <tbody id="tbodyVendedores">
            <tr>
              <td>Mariane</td>
              <td>14</td>
              <td><input class="input-mini" type="number" value="250"></td>
              <td>R$ 3.500,00</td>
            </tr>
            <tr>
              <td>Vinicius</td>
              <td>9</td>
              <td><input class="input-mini" type="number" value="150"></td>
              <td>R$ 1.350,00</td>
            </tr>
            <tr>
              <td>Paula</td>
              <td>6</td>
              <td><input class="input-mini" type="number" value="200"></td>
              <td>R$ 1.200,00</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- PRODUÇÃO -->
    <div class="card">
      <h2>Comissão da Produção</h2>
      <p class="sub">Cadastro manual dos produtores e cálculo por quantidade de sofás produzidos.</p>

      <div class="form-grid">
        <input id="nomeProdutor" class="control" type="text" placeholder="Nome do produtor">
        <input id="qtdProduzida" class="control" type="number" placeholder="Qtd. sofás">
        <input id="valorPorSofa" class="control" type="number" placeholder="Valor por sofá">
        <button id="btnAdicionarProducao" class="btn-add" type="button">Adicionar</button>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Produtor</th>
              <th>Qtd. produzida</th>
              <th>Valor por sofá</th>
              <th>Total</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody id="tbodyProducao">
            <tr>
              <td>Carlos</td>
              <td>12</td>
              <td>R$ 80,00</td>
              <td>R$ 960,00</td>
              <td><button class="btn-remove" type="button">Remover</button></td>
            </tr>
            <tr>
              <td>João</td>
              <td>8</td>
              <td>R$ 75,00</td>
              <td>R$ 600,00</td>
              <td><button class="btn-remove" type="button">Remover</button></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="total-box">
        <span>Total comissão produção</span>
        <span class="total-valor" id="totalProducao">R$ 1.560,00</span>
      </div>
    </div>

  </div>

</div>

<script>
function moedaBRL(v){
  return Number(v || 0).toLocaleString("pt-BR", { style:"currency", currency:"BRL" });
}

// etapa 1: somente estrutura visual
// próxima etapa: ligar ao Firebase e calcular de verdade

document.getElementById("btnAdicionarProducao").onclick = () => {
  const nome = document.getElementById("nomeProdutor").value.trim();
  const qtd = Number(document.getElementById("qtdProduzida").value || 0);
  const valor = Number(document.getElementById("valorPorSofa").value || 0);

  if (!nome || !qtd || !valor){
    alert("Preencha nome, quantidade e valor por sofá.");
    return;
  }

  const total = qtd * valor;

  const tbody = document.getElementById("tbodyProducao");
  const tr = document.createElement("tr");

  tr.innerHTML = `
    <td>${nome}</td>
    <td>${qtd}</td>
    <td>${moedaBRL(valor)}</td>
    <td>${moedaBRL(total)}</td>
    <td><button class="btn-remove" type="button">Remover</button></td>
  `;

  tbody.appendChild(tr);

  tr.querySelector(".btn-remove").onclick = () => {
    tr.remove();
    recalcularTotalProducao();
  };

  document.getElementById("nomeProdutor").value = "";
  document.getElementById("qtdProduzida").value = "";
  document.getElementById("valorPorSofa").value = "";

  recalcularTotalProducao();
};

document.querySelectorAll(".btn-remove").forEach(btn => {
  btn.onclick = () => {
    btn.closest("tr").remove();
    recalcularTotalProducao();
  };
});

function recalcularTotalProducao(){
  const linhas = document.querySelectorAll("#tbodyProducao tr");
  let total = 0;

  linhas.forEach(linha => {
    const texto = linha.children[3]?.textContent || "0";
    const numero = Number(
      texto.replace(/[R$\s.]/g, "").replace(",", ".")
    ) || 0;
    total += numero;
  });

  document.getElementById("totalProducao").textContent = moedaBRL(total);
}
</script>

</body>
</html>
